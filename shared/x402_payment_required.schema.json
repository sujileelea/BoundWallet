{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "x402_payment_required.schema.json",
  "title": "X402PaymentRequired",
  "description": "seller → executor. 402 응답 본문. ⚠️ 잠정: 스파이크 S2에서 @x402/svm 실스펙 확정 후 이 스키마를 맞춘다 (HANDOFF §7.4)",
  "type": "object",
  "required": ["x402Version", "accepts"],
  "properties": {
    "x402Version": { "type": "integer" },
    "accepts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scheme", "network", "asset", "maxAmountRequired", "payTo", "resource"],
        "properties": {
          "scheme": { "type": "string" },
          "network": { "const": "solana-devnet" },
          "asset": { "type": "string" },
          "maxAmountRequired": { "type": "string", "description": "최소 단위(USDC 6 decimals) 문자열" },
          "payTo": { "type": "string", "description": "수취 지갑 주소(base58)" },
          "resource": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
