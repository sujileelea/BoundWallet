# web (Next.js 16). NEXT_PUBLIC_* 는 빌드 시 주입되므로 executor·agent URL을 build-arg로 받는다.
# 컨텍스트 = 레포 루트.
FROM node:26-slim
WORKDIR /app
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web ./
ARG NEXT_PUBLIC_EXECUTOR_URL
ARG NEXT_PUBLIC_AGENT_URL
ENV NEXT_PUBLIC_EXECUTOR_URL=$NEXT_PUBLIC_EXECUTOR_URL
ENV NEXT_PUBLIC_AGENT_URL=$NEXT_PUBLIC_AGENT_URL
RUN npm run build
CMD ["npm", "run", "start"]
